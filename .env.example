# Copy to .env and fill in. NEVER commit .env. Testnet keys only.

# Network (Base Sepolia)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Actor keys (each actor has its own key)
ADMIN_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
BUYER_A_PRIVATE_KEY=
BUYER_B_PRIVATE_KEY=
LP_PRIVATE_KEY=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# offline = deterministic templated text (no API calls); online = Anthropic API
LLM_MODE=offline
